generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id              String    @id @default(uuid())
  name            String
  price           Float
  category        Category  @default(VARIOS)
  sizes           String[]  @default([])
  colors          String[]  @default([])
  stock           Int       @default(0)
  shippingMinutes Int       @default(60)
  description     String?
  images          String[]  @default([])
  imageUrl        String?
  videoUrl        String?
  promoType       PromoType @default(NONE)
  discountPercent Int       @default(0)
  isFeatured      Boolean   @default(false)
  isHotSale       Boolean   @default(false)
  isBlackFriday   Boolean   @default(false)
  isAvailable     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Order {
  id               String          @id @default(uuid())
  userId           String?
  phone            String
  recipientName    String?
  address          String?
  deliveryOption   String?
  deliveryDay      String?
  deliveryTimeSlot String?
  payment          String?
  paymentMethod    String?
  paymentLink      String?
  totalAmount      Float
  itemsSummary     String
  receiptUrl       String?
  status           OrderStatus     @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User?           @relation(fields: [userId], references: [id])
  returnRequests   ReturnRequest[]
}

model ReturnRequest {
  id                 String   @id @default(uuid())
  orderId            String
  phone              String
  type               String
  productCondition   String
  reason             String
  imageUrl           String?
  shippingCost       Float?
  shippingReceiptUrl String?
  status             String   @default("PENDING_REVIEW")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              Order    @relation(fields: [orderId], references: [id])
}

model UserSession {
  phone            String   @id
  userId           String?
  step             String   @default("IDLE")
  tempData         String?  @default("{}")
  cartJson         String?  @default("[]")
  currentProdId    String?
  currentOrderId   String?
  currentReturnId  String?
  returnType       String?
  tempOrderId      String?
  tempCondition    String?
  selectedSize     String?
  currentSize      String?
  selectedColor    String?
  currentColor     String?
  quantity         Int?     @default(1)
  deliveryOption   String?
  deliveryDay      String?
  timeSlot         String?
  deliveryTimeSlot String?
  paymentMethod    String?
  recipientName    String?
  address          String?
  shippingAddr     String?
  updatedAt        DateTime @updatedAt
}

model PaymentConfig {
  id                 String   @id @default(uuid())
  mpPaymentLink      String?
  mpQrCodeUrl        String?
  paypalLink         String?
  bankAlias          String?
  returnShippingCost Float    @default(3500)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum Role {
  CLIENT
  ADMIN
}

enum Category {
  PERFUMES
  MOCHILAS_CARTERAS
  MODA_MUJER
  JOYA_ACCESORIOS
  BAZAR
  CALZADOS_IMPORTADOS
  TECNOLOGIA
  VARIOS
}

enum PromoType {
  NONE
  TWO_FOR_ONE
  PERCENTAGE
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PAYMENT_IN_REVIEW
  APPROVED
  SHIPPED
  RESCHEDULED
  DELIVERED
  CANCELLED
  REJECTED
}

enum ReturnType {
  CAMBIO
  DEVOLUCION
}

enum ReturnStatus {
  PENDING_REVIEW
  APPROVED_AWAITING_PAYMENT
  PAYMENT_IN_REVIEW
  COMPLETED
  REJECTED
}
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}